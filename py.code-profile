{
  "name": "Python Learning - Zero to Nerd",
  "extensions": [
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-python.debugpy",
    "charliermarsh.ruff",
    "tamasfe.even-better-toml",
    "njpwerner.autodocstring",
    "donjayamanne.python-environment-manager",
    "matangover.mypy",
    "ms-toolsai.jupyter",
    "ms-toolsai.jupyter-keymap",
    "ms-toolsai.jupyter-renderers",
    "ms-python.black-formatter",
    "littlefoxteam.vscode-python-test-adapter",
    "hbenl.vscode-test-explorer",
    "eamodio.gitlens",
    "streetsidesoftware.code-spell-checker",
    "editorconfig.editorconfig",
    "yzhang.markdown-all-in-one",
    "bierner.markdown-emoji",
    "davidanson.vscode-markdownlint"
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.languageServer": "Pylance",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
      "."
    ],
    "python.testing.autoTestDiscoverOnSaveEnabled": true,
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
        "source.fixAll": "explicit"
      },
      "editor.rulers": [
        88,
        120
      ],
      "editor.tabSize": 4,
      "editor.insertSpaces": true
    },
    "ruff.enable": true,
    "ruff.lint.enable": true,
    "ruff.format.args": [
      "--line-length=88"
    ],
    "ruff.lint.args": [
      "--select=E,F,W,I,N,UP,B,A,C4,SIM,PYI,RUF"
    ],
    "autoDocstring.docstringFormat": "google",
    "autoDocstring.startOnNewLine": false,
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/.mypy_cache": true,
      "**/.venv": false
    },
    "files.watcherExclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/.mypy_cache": true
    },
    "editor.minimap.enabled": true,
    "editor.minimap.maxColumn": 88,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.inlayHints.enabled": "on",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "gitlens.codeLens.enabled": true,
    "gitlens.currentLine.enabled": true,
    "markdown.extension.toc.levels": "2..6",
    "markdown.extension.list.indentationSize": "inherit",
    "markdownlint.config": {
      "MD013": false,
      "MD033": false,
      "MD041": false
    },
    "cSpell.words": [
      "pytest",
      "pylance",
      "autodocstring",
      "mypy",
      "dataclasses",
      "datetime",
      "stdlib",
      "pythonic",
      "docstring",
      "docstrings",
      "REPL",
      "venv",
      "pyproject",
      "ritishbhatoye"
    ],
    "cSpell.enableFiletypes": [
      "python",
      "markdown",
      "plaintext"
    ],
    "notebook.output.textLineLimit": 50,
    "notebook.cellToolbarLocation": {
      "default": "right",
      "jupyter-notebook": "left"
    }
  },
  "tasks": [
    {
      "label": "Run Current Python File",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Run Tests (Current File)",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "-m",
        "pytest",
        "${file}",
        "-v"
      ],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Run All Tests",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "-m",
        "pytest",
        ".",
        "-v"
      ],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Format with Ruff",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "-m",
        "ruff",
        "format",
        "${file}"
      ],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Lint with Ruff",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "-m",
        "ruff",
        "check",
        "${file}",
        "--fix"
      ],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ],
  "launch": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Debug Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v",
        "-s"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
